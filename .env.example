# Copia este archivo como .env.local y completa los dos valores.
# Los encuentras en Supabase > Project Settings > API (URL del proyecto y clave pública anon/publishable).
# Nunca pongas aquí la clave "service_role": esa jamás va en el frontend.
VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co
VITE_SUPABASE_ANON_KEY=tu-clave-publica
